# Odoo Online connection details
# Copy this file to .env and fill in your values (never commit .env)

# Your Odoo Online instance URL, e.g. https://yourcompany.odoo.com
ODOO_URL=

# Database name (usually the subdomain part of your Odoo URL, e.g. "yourcompany")
ODOO_DB=

# Login email of the user the API should act as
ODOO_USERNAME=

# API key generated at: Settings > Users & Companies > Users > (your user) > Account Security > New API Key
# (Use an API key, not your login password)
ODOO_API_KEY=

# Port the local REST API listens on (LAN-only, no auth)
PORT=4001
